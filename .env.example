MONGO_URI=mongodb://192.168.1.82:27017
MONGO_DB_NAME=chronosense
MONGO_CONNECT_TIMEOUT_MS=5000
CHRONOSENSE_RECOGNITION_THRESHOLD=0.28
CHRONOSENSE_EMOTION_RECOGNITION_THRESHOLD=0.28
CHRONOSENSE_EMOTION_BACKEND=emotiefflib
CHRONOSENSE_EMOTIEFFLIB_ENGINE=onnx
CHRONOSENSE_EMOTIEFFLIB_MODEL_NAME=enet_b2_8
CHRONOSENSE_EMOTIEFFLIB_DEVICE=cpu
CHRONOSENSE_EMOTION_CONSENSUS_THRESHOLD=0.25
CHRONOSENSE_EMOTION_ANALYTICS_QUALITY_THRESHOLD=0.32
CHRONOSENSE_EMOTION_QUALITY_THRESHOLD=0.32
CHRONOSENSE_EMOTION_WINDOW_FRAMES=5
CHRONOSENSE_EMOTION_WINDOW_SECONDS=1.0
CHRONOSENSE_EMOTION_SMOOTHING_ALPHA=0.55
CHRONOSENSE_MIN_EMOTION_FACE_SIZE=48
CHRONOSENSE_ABSOLUTE_MIN_EMOTION_FACE_SIZE=28
CHRONOSENSE_TARGET_EMOTION_FACE_SIZE=112
CHRONOSENSE_EMOTION_INFERENCE_WIDTH=1440
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chronosense

# Emotion backend: auto, emotiefflib, mma_dfer, ferplus, or disabled
CHRONOSENSE_EMOTION_BACKEND=auto
CHRONOSENSE_EMOTIEFFLIB_ENGINE=onnx
CHRONOSENSE_EMOTIEFFLIB_MODEL_NAME=enet_b2_8
CHRONOSENSE_EMOTIEFFLIB_DEVICE=cpu
CHRONOSENSE_FERPLUS_MODEL_URL=https://github.com/onnx/models/raw/main/vision/body_analysis/emotion_ferplus/model/emotion-ferplus-8.onnx
CHRONOSENSE_MMA_DFER_CHECKPOINT_PATH=backend/models/mma-dfer/fold1_112.pth
# Required only with ./scripts/setup/install.sh --with-mma-dfer
# CHRONOSENSE_MMA_DFER_CHECKPOINT_URL=
